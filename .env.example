# Gemini API Keys for rotation (comma-separated)
# Add your actual API keys to .env or .env.local (which are git-ignored)
# NEVER commit actual API keys to version control
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2

# API Endpoint for backend proxy
VITE_API_ENDPOINT=http://localhost:3001/api/chat

# Journal Summary API Endpoint
VITE_JOURNAL_SUMMARY_ENDPOINT=http://localhost:3001/api/journal-summary